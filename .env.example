# figgsite — copy to .env (chmod 600). NEVER commit .env.
# Keys go here, not in docs/patches/chat.

# ── pi bridge (site chat) ────────────────────────────────────────────
# pi reads provider keys from env. Fund ONE of these.
#   OPENCODE_API_KEY  — opencode-go (mimo). NOTE: currently 402 Insufficient funds.
#   ANTHROPIC_API_KEY / OPENAI_API_KEY / OPENROUTER_API_KEY / GEMINI_API_KEY
OPENCODE_API_KEY=
ANTHROPIC_API_KEY=

# Bridge port + shared token (site and bridge must agree)
BRIDGE_PORT=8797
BRIDGE_TOKEN=

# ── dashboard (dash/) ────────────────────────────────────────────────
DASH_PORT=8794
DASH_TOKEN=

# ── R2 (assets) — the token pasted in chat is BURNED, rotate it ──────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Google sign-in ──────────────────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
#   Type: Web application
#   Origins:  https://pog.pet , https://www.pog.pet
#   Redirect: https://pog.pet/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin used to build the redirect URI
PUBLIC_BASE=https://pog.pet

# ── print providers (live pricing; keys env-only, ask-first spend) ───
PRODIGI_API_KEY=
PRODIGI_BASE=https://api.prodigi.com
PRODIGI_SANDBOX_KEY=
GELATO_API_KEY=
PRINTIFY_API_TOKEN=
# PRINTIFY_SHOP_ID= (dashboard: shop settings)
# GELATO_STORE_ID= (dashboard: store settings)

# ── 3D farm (direct API; estimating free, process charges) ───────────
SLANT3D_API_KEY=

# ── AI processing (ask-first spend, ledgers in data/*.jsonl) ─────────
FAL_KEY=
MESHY_API_KEY=
OPENROUTER_API_KEY=

# ── R2 source bucket (import only; least-privilege S3 creds) ─────────
STALLSHARK_ACCOUNT_ID=
STALLSHARK_S3_ENDPOINT=
STALLSHARK_S3_ACCESS_KEY_ID=
STALLSHARK_S3_SECRET_ACCESS_KEY=
