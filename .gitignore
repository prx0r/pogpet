# secrets — never commit
.env
.env.local
*.key
token
.token
.vault_key
*.pem

# runtime
*.log
*.pid
*.db
*.db-shm
*.db-wal
__pycache__/
*.pyc
.pytest_cache/

# local pipeline state: sqlite, staged photos, downloaded meshes
data/

# reference clones (read-only research copies, re-clone anytime)
backend/resources/repos/

# figg-studio: the nested kit zip is rebuilt by scripts/package.py
figg-studio/downloads/*.zip

# node
node_modules/
dist/
*.tsbuildinfo
.vite/

# pi (vendored, its own .gitignore also applies)
pi/auth.json
pi/.artifacts/

# local assets that live in R2, not git
assets/style/*.png

# SFace embedding model (38MB) — download on demand, never commit.
# backend/faces.py fetches it automatically; YuNet (227KB) stays tracked.
assets/face/face_recognition_sface_2021dec.onnx
