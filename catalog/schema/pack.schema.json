{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "oddhobb/pack.schema.json",
 "title": "OddHobb canonical product pack (product.json)",
 "type": "object",
 "required": ["schema_version", "sku", "name", "family", "kind", "parents", "geometry", "manufacture", "cost", "slots", "audience", "listing", "assets", "graph"],
 "properties": {
  "schema_version": {"const": 2},
  "sku": {"type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)+$"},
  "name": {"type": "string", "minLength": 3},
  "family": {"type": "string"},
  "kind": {"enum": ["personalised", "fixed"]},
  "domain": {"enum": ["manufactured_mesh", "flat_print", "multi_panel_print", "digital_media"]},
  "print": {"type": "object",
   "properties": {"trim_mm": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 3},
    "bleed_mm": {"type": "number"}, "safe_mm": {"type": "number"}, "dpi": {"type": "number"},
    "colour_space": {"type": "string"}, "supplier_sku": {"type": "string"}, "print_hash": {"type": ["string", "null"]}}},
  "marketing": {"type": "object",
   "properties": {"positioning": {"type": "string"}, "audiences": {"type": "array", "items": {"type": "string"}},
    "angles": {"type": "array", "items": {"type": "string"}}, "claims": {"type": "array", "items": {"type": "string"}},
    "forbidden_claims": {"type": "array", "items": {"type": "string"}}, "hero_assets": {"type": "array"},
    "hooks": {"type": "array"}, "motion_recipes": {"type": "array"}}},
  "generative": {"type": "object",
   "properties": {"transform_id": {"type": "string"}, "transform_version": {"type": "integer"},
    "prompt_id": {"type": "string"}, "prompt_version": {"type": "integer"},
    "renderer_id": {"type": "string"}, "renderer_version": {"type": "integer"},
    "qc_contract": {"type": "string"}, "sample_outputs": {"type": "array"}}},
  "parents": {"type": "array", "items": {"type": "string"}},
  "geometry": {"type": "object", "required": ["units", "dims_mm", "volume_cm3"],
   "properties": {"units": {"const": "mm"}, "dims_mm": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "volume_cm3": {"type": ["number", "null"]}, "faces": {"type": ["integer", "null"]}, "shells": {"type": ["integer", "null"]},
    "size_variants_mm": {"type": "array"}, "locked_features": {"type": "array", "items": {"type": "object", "required": ["id", "note"]}}, "source": {"type": "object"}}},
  "manufacture": {"type": "object", "required": ["supplier", "process", "material", "finish", "colour", "hand_finish", "fulfilment", "print_file", "preflight", "lead_time_days"],
   "properties": {
    "supplier": {"type": "string"}, "process": {"type": "string"}, "material": {"type": ["string", "null"]}, "finish": {"type": ["string", "null"]}, "colour": {"type": ["string", "null"]},
    "hand_finish": {"type": "array", "items": {"type": "string"}},
    "fulfilment": {"enum": ["dropship", "via-oddhobb"]},
    "print_file": {"type": "object", "required": ["path", "sha256", "format"], "properties": {"path": {"type": ["string", "null"]}, "sha256": {"type": ["string", "null"]}, "format": {"type": ["string", "null"]}}},
    "preflight": {"type": "object", "required": ["report", "acknowledged"], "properties": {"report": {"type": ["string", "null"]}, "acknowledged": {"type": "object", "additionalProperties": {"type": "string"}}}},
    "supplier_settings": {"type": "object"},
    "lead_time_days": {"type": "object", "required": ["build", "ship_min", "ship_max"]}}},
  "cost": {"type": "object", "required": ["currency", "print", "shipping"],
   "properties": {"currency": {"const": "USD"},
    "print": {"$ref": "#/$defs/money"}, "shipping": {"$ref": "#/$defs/money"}, "packaging": {"$ref": "#/$defs/money"}}},
  "slots": {"type": "array", "items": {"$ref": "#/$defs/slot"}},
  "audience": {"type": "object", "required": ["suits", "occasions", "relationship_to_buyer", "not_for"],
   "properties": {"suits": {"type": "array"}, "occasions": {"type": "array"}, "interests": {"type": "array"}, "relationship_to_buyer": {"type": "array"}, "not_for": {"type": "array"}, "price_band": {"type": ["string", "null"]}, "tone": {"type": "array"}}},
  "listing": {"type": "object", "required": ["title", "price", "tags", "materials", "description", "spec_rows", "processing", "channels", "images"],
   "properties": {"title": {"type": "string"}, "price": {"type": "object", "required": ["currency", "amount"], "properties": {"currency": {"const": "GBP"}, "amount": {"type": ["number", "null"]}}},
    "tags": {"type": "array", "items": {"type": "string"}}, "materials": {"type": "array", "items": {"type": "string"}}, "short": {"type": "string"},
    "description": {"type": "string"}, "spec_rows": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2}},
    "processing": {"type": "string"}, "channels": {"type": "array", "items": {"enum": ["etsy", "oddhobb-store"]}},
    "images": {"type": "array", "items": {"type": "object", "required": ["file", "role", "alt"], "properties": {"file": {"type": "string"}, "role": {"enum": ["hero", "view", "detail", "scale", "spec", "lifestyle", "personalisation"]}, "alt": {"type": "string"}}}}}},
  "assets": {"type": "object"},
  "graph": {"type": "object", "properties": {"related": {"type": "array", "items": {"type": "object", "required": ["sku", "rel"]}}, "extends_to": {"type": "array"}}},
  "samples": {"type": "array", "items": {"type": "object", "required": ["photo", "received", "verdict"]}},
  "ext": {"type": "object"}
 },
 "$defs": {
  "money": {"type": "object", "required": ["amount", "basis"], "properties": {"amount": {"type": ["number", "null"]}, "basis": {"enum": ["quote", "invoice", "estimate", null]}, "ref": {"type": ["string", "null"]}, "date": {"type": ["string", "null"]}, "region": {"type": ["string", "null"]}}},
  "slot": {"type": "object", "required": ["id", "type", "label", "required", "offered", "validated", "surface", "method"],
   "properties": {"id": {"type": "string"}, "type": {"enum": ["text", "image", "colour", "mesh"]}, "label": {"type": "string"},
    "required": {"type": "boolean"}, "offered": {"type": "boolean"}, "validated": {"type": "boolean"}, "evidence": {"type": ["string", "null"]},
    "surface": {"type": "object"}, "method": {"type": "string"}, "text": {"type": "object"}, "colour": {"type": "object"}, "image": {"type": "object"}, "mesh": {"type": "object"},
    "profile_source": {"type": "array"}, "fallback_source": {"type": "array"}, "preview": {"type": "string"}}}
 }
}
