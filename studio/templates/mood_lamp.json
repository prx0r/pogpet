{
 "id": "TPL-MOOD-LAMP",
 "name": "Agent mood lamp",
 "version": 0,
 "pitch": "A desk light that shows how your agent feels, and dims itself to the room.",
 "parts": [
  {
   "ref": "LED1-12",
   "part": "ws2812b",
   "qty": 12,
   "role": "ring",
   "layout": {
    "ring_d_mm": 52
   }
  },
  {
   "ref": "U2",
   "part": "bh1750",
   "qty": 1,
   "role": "ambient",
   "placement": "top window, behind clear diffuser"
  },
  {
   "ref": "U1",
   "part": "esp32c3",
   "qty": 1,
   "role": "brain"
  }
 ],
 "power": {
  "source": "USB-C 5V",
  "budget_ma": 500,
  "reserve_ma": 120,
  "note": "LED cap derived from budget minus MCU+reserve"
 },
 "pcb": {
  "layers": 2,
  "w_mm": 60,
  "h_mm": 60,
  "shape": "round",
  "passives_joints": 60,
  "extra_joints": 16
 },
 "enclosure": {
  "process": "sla",
  "material": "clear resin diffuser + base",
  "volume_cm3": 38.0,
  "note": "volume is a placeholder until the enclosure mesh exists"
 },
 "capabilities": {
  "light.set": {
   "args": {
    "rgb": "hex",
    "brightness": "0-1",
    "transition_ms": "int>=150"
   },
   "desc": "Set the ring colour"
  },
  "light.express": {
   "args": {
    "emotion": "joy|calm|sad|stressed|surprised|thinking|neutral",
    "intensity": "0-1"
   },
   "desc": "Show an emotion"
  },
  "sensor.lux": {
   "returns": "lux float",
   "desc": "Ambient light level"
  },
  "event.ambient_changed": {
   "payload": {
    "lux": "float"
   },
   "desc": "Fires on a >25% ambient change"
  }
 },
 "invariants": {
  "max_flash_hz": 3.0,
  "min_transition_ms": 150,
  "max_led_ma": 380,
  "night_lux": 10,
  "night_max_brightness": 0.12,
  "min_big_change_gap_ms": 400
 }
}