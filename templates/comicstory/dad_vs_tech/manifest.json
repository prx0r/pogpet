{
  "id": "dad_vs_tech",
  "version": 1,
  "format": "comic_strip",
  "premise": "dad_vs_technology",
  "caption_pattern": "{panel_caption}",
  "tone": ["funny", "warm"],
  "rules": {"escalation": "each panel makes it worse",
            "payoff": "panel 4: asks a child for help"},
  "video_ready": false,
  "face_swap_ready": false,
  "taxonomy": {
    "occasion": ["general", "birthday", "fathers_day", "christmas"],
    "styles": ["comicstory"],
    "topics": ["family", "comedy"],
    "tone": ["ross", "warm"]
  },
  "requirements": {"subjects": 1, "face_photos_min": 0, "mesh": false, "voice": false},
  "slots": {
    "star": {"type": "subject", "required": true},
    "panel_1": {"type": "text", "max_chars": 80, "default": "Dad says he'll fix it"},
    "panel_2": {"type": "text", "max_chars": 80, "default": "Dad makes it worse"},
    "panel_3": {"type": "text", "max_chars": 80, "default": "Dad blames the Wi-Fi"},
    "panel_4": {"type": "text", "max_chars": 80, "default": "Dad asks a child for help"}
  },
  "beats": ["setup", "escalation", "reversal", "payoff"],
  "renderers": {"preview": "composite2d", "hero": "identity_image_v1",
                "print": "composite2d", "video": "talking_scene_v1"},
  "layout": {"panels": 4, "safe_inset_mm": 5},
  "files": {"layout": "layout/card.polotno.json"}
}
