{
  "id": "breaking_news",
  "version": 1,
  "taxonomy": {
    "occasion": ["general", "birthday", "fathers_day", "retirement"],
    "styles": ["newsparody", "photorealstudio"],
    "topics": ["family", "news"],
    "tone": ["absurd", "mock-serious"]
  },
  "requirements": {
    "subjects": 1,
    "face_photos_min": 1,
    "mesh": false,
    "voice": false
  },
  "slots": {
    "star": {"type": "subject", "required": true},
    "headline": {"type": "text", "max_chars": 42},
    "subheadline": {"type": "text", "max_chars": 90},
    "location": {"type": "text", "default": "ODDHOBB NEWS HQ"}
  },
  "renderers": {
    "preview": "composite2d",
    "hero": "identity_image_v1",
    "print": "composite2d",
    "video": "talking_scene_v1"
  },
  "files": {
    "layout": "layout/card.polotno.json",
    "prompts": "prompts/image.txt"
  }
}
