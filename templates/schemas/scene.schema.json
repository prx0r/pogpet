{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OddHobb scene revision",
  "type": "object",
  "required": ["scene_version", "template", "copy"],
  "properties": {
    "scene_version": {"type": "string", "pattern": "^oddhobb\\.scene\\.v[0-9]+$"},
    "template": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slot", "subject_id"],
        "properties": {
          "slot": {"type": "string"},
          "subject_id": {"type": "string"},
          "asset_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "copy": {"type": "object"},
    "render_intent": {"type": "object"}
  }
}
